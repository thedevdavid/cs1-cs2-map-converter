<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetConverter\NetConverter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\mapping.tsv" Link="mapping.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tree-mapping.tsv" Link="tree-mapping.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\object-mapping.tsv" Link="object-mapping.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\surface-mapping.tsv" Link="surface-mapping.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\bridges.tsv" Link="bridges.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
